# Copy to .env and fill in. Never commit .env.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Local MongoDB (works on any network):
MONGODB_URI="mongodb://127.0.0.1:27017"
# Or MongoDB Atlas (needs outbound port 27017 and your IP on Network Access):
# MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net"
MONGODB_DB="careweave"

# Report scanning (server-side only)
GEMINI_API_KEY=""
# GEMINI_MODEL="gemma-4-31b-it"  (optional, tried first). Default: Gemma 4, then Gemini Flash if Gemma is busy.

# Firebase Authentication (staff sign-in). The server verifies ID tokens for this project.
# FIREBASE_PROJECT_ID="hacktober-143c4"
# Set to false only after turning off sign-up in Firebase Authentication settings.
# FIREBASE_REQUIRE_VERIFIED_EMAIL=true
# Keep local password sign-in alongside Firebase (development only).
# ALLOW_LOCAL_LOGIN=true

# Exasol Personal Analytics Data Platform
# Install via Exasol Launcher on macOS: curl https://downloads.exasol.com/exasol-personal/installer.sh | sh
EXASOL_HOST="localhost"
EXASOL_PORT=8563
EXASOL_USER="sys"
EXASOL_PASSWORD="your-exasol-password"
EXASOL_SCHEMA="CAREWEAVE_ANALYTICS"

