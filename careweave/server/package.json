{
  "name": "careweave-server",
  "version": "1.0.0",
  "description": "CareWeave API Server with MongoDB Atlas & Front Desk Services",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "seed": "tsx src/seed.ts",
    "import-medicines": "tsx scripts/import-medicines.ts",
    "check-db": "tsx src/check-db.ts",
    "test": "tsx --test src/*.test.ts",
    "test:acceptance": "tsx scripts/acceptance.ts",
