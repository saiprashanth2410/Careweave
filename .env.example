# CareWeave Fullstack Environment Configuration

# Server Configuration
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas (OLTP Transactional Store)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net"
MONGODB_DB="careweave"

# Exasol Personal (OLAP High-Performance Analytics Engine)
# Official macOS Installer: curl https://downloads.exasol.com/exasol-personal/installer.sh | sh
EXASOL_HOST="localhost"
EXASOL_PORT=8563
EXASOL_USER="sys"
EXASOL_PASSWORD="your-exasol-password"
EXASOL_SCHEMA="CAREWEAVE_ANALYTICS"

# Google Gemini / Gemma Vision AI (Report Ingestion)
GEMINI_API_KEY="your-gemini-api-key"

# Firebase Authentication (Staff RBAC)
FIREBASE_PROJECT_ID="hacktober-143c4"
ALLOW_LOCAL_LOGIN="true"

