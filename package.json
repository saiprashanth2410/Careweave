{
  "name": "hacktober-fest",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "careweave/client",
    "careweave/server"
  ],
  "scripts": {
    "dev": "cd careweave/client && npm run dev",
    "build": "cd careweave/client && npm install --include=optional @rolldown/binding-linux-x64-gnu && npm run build",
    "lint": "cd careweave/client && npm run lint",
    "preview": "cd careweave/client && npm run preview",
    "server": "cd careweave/server && npm run dev",
    "server:seed": "cd careweave/server && npm run seed",
    "check-db": "cd careweave/server && npm run check-db",
    "medlink:dev": "cd medlink && env -u INIT_CWD npm run dev",
    "medlink:build": "cd medlink && env -u INIT_CWD npm run build"
  },
  "dependencies": {
    "@exasol/exasol-driver-ts": "^0.8.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^4.21.2",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.3",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "@vercel/node": "^5.1.10"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "1.2.15",
    "@rolldown/binding-darwin-x64": "1.2.15",
    "@rolldown/binding-linux-arm64-gnu": "1.2.15",
    "@rolldown/binding-linux-arm64-musl": "1.2.15",
    "@rolldown/binding-linux-x64-gnu": "1.2.15",
    "@rolldown/binding-linux-x64-musl": "1.2.15",
    "@rolldown/binding-win32-x64-msvc": "1.2.15"
  }
}
